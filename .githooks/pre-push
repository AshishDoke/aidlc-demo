#!/bin/sh
# AIDLC pre-push gate: verifies audit chain, approvals and scope for aidlc/* branches.
# Enable once per clone (human):  git config core.hooksPath .githooks
ROOT="$(git rev-parse --show-toplevel)"
for PY in python3 python py; do
  if command -v "$PY" >/dev/null 2>&1; then
    exec "$PY" "$ROOT/tools/aidlc/aidlc.py" verify
  fi
done
echo "AIDLC pre-push: Python not found; cannot verify." >&2
exit 1
